---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Beneficios from '../components/Beneficios.astro'
import Vendidos from '../components/Vendidos.astro'
import Banner from '../components/Banner.astro'
import Fila from '../components/Fila.astro'
import Colecciones from '../components/Colecciones.astro'
import Catalogo from '../components/Catalogo.astro'
import Eventos from '../components/Eventos.astro'
import Faq from '../components/Faq.astro'
import Footer from '../components/Footer.astro'
import Carrito from '../components/Carrito.astro'
import Producto from '../components/Producto.astro'
import DatosTienda from '../components/DatosTienda.astro'
import { getTienda } from '../data/api'

const tienda = await getTienda()
const activos = tienda.productos.filter((p) => !p.agotado)
const nuevos = activos.filter((p) => p.nuevo).slice(0, 4)
const collares = activos.filter((p) => p.categoria === 'collares' && !p.nuevo && p.fotos.length > 1).slice(0, 4)
const joyasMano = activos.filter((p) => (p.categoria === 'aretes' || p.categoria === 'anillos') && !p.nuevo).slice(0, 8)
const muneca = activos.filter((p) => (p.categoria === 'pulseras' || p.categoria === 'relojes') && !p.nuevo).slice(0, 4)
---

<Layout title="Lemonel · Más que joyas, historias tuyas" description="Collares, aretes, anillos, pulseras y relojes de Lemonel en acero inoxidable con baño de oro. Elige tus joyas, arma tu carrito y pide por WhatsApp. Pedidos para eventos y envíos a todo el Perú.">
  <Header />
  <main>
    <Hero />
    <Beneficios />
    <Vendidos />
    <Banner id="novedades" foto="/fotos/b-nuevo.webp" etiqueta="Nuevo · Colección 2026" titulo="Pequeños detalles, grandes historias." texto="Diseños que te acompañan siempre. Descubre lo último de Lemonel." boton="Ver novedades" href="#catalogo" posicion="50% 30%" />
    <Fila productos={nuevos} verTodo={{ texto: 'Ver todas las joyas', filtro: 'todo' }} />
    <Banner foto="/fotos/b-collares.webp" etiqueta="Colección" titulo="Collares" texto="Cadenas finas, corazones, cruces y medallones para cada momento." boton="Ver collares" filtro="collares" posicion="50% 38%" derecha />
    <Fila productos={collares} fondo="var(--white)" />
    <Banner foto="/fotos/b-aretes.webp" etiqueta="Colección" titulo="Aretes y anillos" texto="Argollas, flores y aros que se lucen solos o en pareja." boton="Ver aretes" filtro="aretes" posicion="50% 30%" />
    <Fila productos={joyasMano} />
    <Banner id="regalos" foto="/fotos/b-pulseras.webp" etiqueta="Regalos para momentos reales" titulo="Pulseras y relojes" texto="Perlas de río, cierres dorados y relojes atemporales, siempre en su cajita." boton="Ver pulseras" filtro="pulseras" posicion="50% 35%" derecha />
    <Fila productos={muneca} fondo="var(--white)" verTodo={{ texto: 'Ver todas las joyas', filtro: 'todo' }} />
    <Colecciones />
    <Catalogo />
    <Eventos />
    <Faq />
  </main>
  <Footer />
  <Carrito />
  <Producto />
  <DatosTienda tienda={tienda} />
  <script>
    import '../scripts/main.ts'
  </script>
</Layout>
