---
import { collage } from '../data/gallery'

interface Props {
  desfase?: number
  fondo?: string
}

const { desfase = 0, fondo = 'var(--cream)' } = Astro.props
const [a, b] = collage(desfase)
const filaA = [...a, ...a]
const filaB = [...b, ...b]
---

<section class="tira" style={`background:${fondo}`} aria-label="Galería de joyas">
  <div class="tira__row">
    <div class="tira__track" data-tira-track="izq">
      {
        filaA.map((f, i) => (
          <figure class="tira__item">
            <img src={f.src} alt={i < a.length ? f.alt : ''} width={f.w} height={f.h} loading="lazy" decoding="async" aria-hidden={i < a.length ? undefined : 'true'} />
          </figure>
        ))
      }
    </div>
  </div>
  <div class="tira__row">
    <div class="tira__track" data-tira-track="der">
      {
        filaB.map((f, i) => (
          <figure class="tira__item">
            <img src={f.src} alt={i < b.length ? f.alt : ''} width={f.w} height={f.h} loading="lazy" decoding="async" aria-hidden={i < b.length ? undefined : 'true'} />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tira {
    display: grid;
    gap: 6px;
    overflow: hidden;
    padding-block: 6px;
  }

  .tira__row {
    height: clamp(190px, 21vw, 320px);
    overflow: hidden;
  }

  .tira__track {
    display: flex;
    align-items: center;
    width: max-content;
    height: 100%;
    gap: 6px;
    will-change: transform;
  }

  .tira__item {
    flex: none;
    margin: 0;
    height: 100%;
  }

  .tira__item:nth-child(3n + 2) {
    height: 80%;
  }

  .tira__item:nth-child(3n) {
    height: 92%;
  }

  .tira__item img {
    width: auto;
    height: 100%;
    object-fit: cover;
  }
</style>
