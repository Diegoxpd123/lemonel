---
import Icon from './Icon.astro'
import { dinero, etiquetaDe, necesitaElegir, tieneVariantes, type Producto } from '../data/tienda'

interface Props {
  p: Producto
  carrusel?: boolean
  prioridad?: boolean
}

const { p, carrusel = false, prioridad = false } = Astro.props
const precio = dinero(p.precioDesde)
const etiqueta = etiquetaDe(p)
const elegir = necesitaElegir(p)
const principal = p.fotos[0]
const segunda = p.fotos[1]
---

<article class={`card ${carrusel ? 'card--slide' : ''}${p.agotado ? ' card--agotado' : ''}`} data-card data-id={p.id} data-cat={p.categoria} data-col={p.colecciones.join(' ')}>
  <div class="card__media">
    <button class="card__open" type="button" data-abrir-producto={p.id} aria-label={`Ver ${p.nombre}`}>
      {principal && <img class="card__img card__img--a" src={principal.sm} alt={p.nombre} width="640" height={Math.round((640 * principal.alto) / Math.max(principal.ancho, 1))} loading={prioridad ? 'eager' : 'lazy'} decoding="async" />}
      {segunda && <img class="card__img card__img--b" src={segunda.sm} alt="" width="640" height="800" loading="lazy" decoding="async" />}
    </button>
    <button class="card__fav" type="button" aria-label={`Guardar ${p.nombre} en favoritos`} aria-pressed="false" data-fav={p.id}>
      <Icon name="heart" weight="light" class="i-off" />
      <Icon name="heart" weight="fill" class="i-on" />
    </button>
    {etiqueta && <span class={`tag tag--${etiqueta.id}`}>{etiqueta.texto}</span>}
    {
      p.agotado ? null : (
        <button class="card__add" type="button" data-add={p.id} data-elegir={elegir ? 'si' : 'no'} aria-label={elegir ? `Elegir opciones de ${p.nombre}` : `Agregar ${p.nombre} al carrito`}>
          <Icon name="plus" weight="light" />
          <span>{elegir ? 'Elegir' : 'Agregar'}</span>
        </button>
      )
    }
  </div>
  <div class="card__info">
    <h3 class="card__name">{p.nombre}</h3>
    <p class="card__price">
      {tieneVariantes(p) && <span class="card__desde">Desde</span>}
      {precio}
    </p>
  </div>
</article>

<style is:global>
  .card {
    position: relative;
    min-width: 0;
  }

  .card[hidden] {
    display: none;
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--card);
  }

  .card__open {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.45s var(--ease), transform 0.9s var(--ease-out);
  }

  .card__img--b {
    opacity: 0;
  }

  @media (hover: hover) {
    .card:hover .card__img--b {
      opacity: 1;
    }

    .card:hover .card__img {
      transform: scale(1.03);
    }
  }

  .card__fav {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 1.35rem;
    transition: transform 0.25s var(--ease);
  }

  .card__fav:hover {
    transform: scale(1.12);
  }

  .card__fav .i-on {
    display: none;
    color: var(--olive);
  }

  .card__fav[aria-pressed='true'] .i-on {
    display: inline-flex;
  }

  .card__fav[aria-pressed='true'] .i-off {
    display: none;
  }

  .tag {
    position: absolute;
    top: 14px;
    right: 12px;
    z-index: 2;
    padding: 5px 10px;
    border-radius: 6px;
    background: var(--white);
    color: var(--ink);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .tag--nuevo {
    background: var(--olive);
    color: var(--white);
  }

  .tag--vendido {
    background: var(--rose);
  }

  .tag--agotado {
    background: var(--ink);
    color: var(--white);
  }

  .card--agotado .card__img {
    opacity: 0.62;
  }

  .card--agotado:hover .card__img--b {
    opacity: 0.62;
  }

  .card__desde {
    margin-right: 6px;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card__add {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    border: 0;
    border-radius: 12px;
    background: rgba(254, 252, 248, 0.94);
    color: var(--olive);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.4s var(--ease-out), opacity 0.3s var(--ease);
  }

  .card__add .icon {
    font-size: 1.1rem;
  }

  .card__add:hover {
    background: var(--olive);
    color: var(--white);
  }

  .card__add:hover .icon {
    color: var(--white);
  }

  @media (hover: hover) {
    .card__add {
      opacity: 0;
      transform: translateY(12px);
    }

    .card:hover .card__add,
    .card__add:focus-visible {
      opacity: 1;
      transform: none;
    }
  }

  .card__info {
    padding-top: 14px;
  }

  .card__name {
    font-family: var(--font-text);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .card__price {
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .card__name {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
    }

    .card__add {
      display: grid;
      place-items: center;
      left: auto;
      right: 8px;
      bottom: 8px;
      width: 40px;
      min-height: 40px;
      padding: 0;
      border-radius: 50%;
    }

    .card__add span:not(.icon) {
      display: none;
    }

    .card__add .icon {
      width: 22px;
      height: 22px;
      font-size: 22px;
      color: var(--olive);
    }

    .card__fav {
      top: 6px;
      left: 6px;
    }

    .tag {
      top: 12px;
      right: 8px;
    }
  }
</style>
