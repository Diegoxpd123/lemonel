---
import Icon from './Icon.astro'
import { productos } from '../data/products'
import { config } from '../data/config'

const slides = productos.filter((p) => p.hero)
const primero = slides[0]
const tonos = ['amber', 'forest', 'plum', 'wine', 'olive-deep', 'plum', 'amber', 'forest']
const discos = ['claro', 'claro', 'oscuro', 'oscuro', 'claro', 'claro', 'claro', 'claro']
const filas = ['Lemonel', 'Amor en cada detalle', 'Joyas para regalar']
---

<section class="hero" id="inicio" data-hero>
  <div class="hero__words" aria-hidden="true">
    {
      filas.map((f) => (
        <div class="hero__row" data-hero-row>
          {Array.from({ length: 8 }).map(() => <span>{f}</span>)}
        </div>
      ))
    }
  </div>

  <div class="hero__grid wrap">
    <div class="hero__copy">
      <h1 class="hero__title">
        <span class="hero__line"><span data-hero-line>Joyas que</span></span>
        <span class="hero__line"><span data-hero-line>llegan como</span></span>
        <span class="hero__line"><span data-hero-line>un regalo</span></span>
      </h1>

      <p class="hero__lead" data-hero-in>
        Elige tus favoritas, arma tu caja y envíanos el pedido por WhatsApp. Nosotras la preparamos con lazo y tarjeta.
      </p>

      <div class="hero__actions" data-hero-in>
        <a class="btn btn--cream" href="#catalogo">
          Arma tu caja
          <Icon name="arrow-right" weight="bold" />
        </a>
        <a class="btn btn--ghost" href="#eventos">
          <span class="solo-desk">Pedir para un evento</span>
          <span class="solo-movil">Para eventos</span>
        </a>
      </div>

      <div class="now" data-hero-in data-now>
        <div class="now__text">
          <span class="now__name" data-now-name>{primero.nombre}</span>
          <span class="now__note" data-now-note>{primero.nota}</span>
        </div>
        <button class="now__add" type="button" data-add={primero.id} data-now-add>
          <Icon name="plus" weight="bold" />
          <span>A la caja</span>
          <strong data-now-price>{config.moneda} {primero.precio}</strong>
        </button>
      </div>
    </div>

    <div class="hero__stage" data-hero-stage>
      <div class="hero__disc" data-disc></div>
      {
        slides.map((p, i) => (
          <img
            class="hero__img"
            src={p.hero}
            alt={p.alt}
            width="1000"
            height="1000"
            data-slide={p.id}
            data-index={i}
            data-tone={tonos[i % tonos.length]}
            data-disc={discos[i % discos.length]}
            fetchpriority={i === 0 ? 'high' : 'low'}
            style={i === 0 ? undefined : 'opacity:0;visibility:hidden'}
          />
        ))
      }
    </div>
  </div>

  <div class="dots wrap" role="tablist" aria-label="Elegir joya" data-dots>
    {
      slides.map((p, i) => (
        <button class="dot" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={p.nombre} data-dot={i}>
          <img src={p.hero} alt="" width="64" height="64" loading="lazy" decoding="async" />
          <i></i>
        </button>
      ))
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(38px + 76px + clamp(8px, 1.4vw, 18px));
    background: var(--amber);
    color: #fffdf5;
    overflow: hidden;
  }

  .hero__words {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__row {
    display: flex;
    width: max-content;
    white-space: nowrap;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    font-style: italic;
    font-size: clamp(5.5rem, 15vw, 15rem);
    font-weight: 640;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: rgba(255, 253, 245, 0.1);
    will-change: transform;
  }

  .hero__row span {
    padding-right: 0.5em;
  }

  .hero__grid {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(8px, 1.4vw, 20px);
  }

  .hero__copy {
    display: grid;
    gap: clamp(16px, 2vw, 26px);
    justify-items: start;
    align-content: center;
    position: relative;
    z-index: 2;
  }

  .hero__title {
    font-size: clamp(3rem, min(8.6vw, 14svh), 10.6rem);
    line-height: 0.9;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.18em;
    margin-bottom: -0.12em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    font-size: clamp(1.1rem, 1.45vw, 1.4rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .now {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: min(100%, 36rem);
    padding: 12px 12px 12px 24px;
    border-radius: 22px;
    background: var(--cream);
    color: var(--ink);
  }

  .now__text {
    display: grid;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
  }

  .now__name {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 72;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 640;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .now__note {
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .now__add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    min-height: 52px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: var(--olive-deep);
    color: var(--cream);
    font-weight: 700;
    font-size: 1.02rem;
    transition: transform 0.35s var(--ease);
  }

  .now__add:hover {
    transform: translateY(-2px);
  }

  .now__add :global(.icon) {
    font-size: 1.1rem;
  }

  .hero__stage {
    position: relative;
    justify-self: center;
    display: grid;
    place-items: center;
    width: min(100%, calc(100svh - 230px), 860px);
    aspect-ratio: 1;
  }

  .hero__disc {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: #fffdf5;
  }

  .hero__img {
    position: absolute;
    inset: 6%;
    width: 88%;
    height: 88%;
    object-fit: contain;
    will-change: transform, opacity;
  }

  .dots {
    position: relative;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding-bottom: clamp(12px, 1.6vw, 20px);
    padding-top: 6px;
  }

  .dot {
    position: relative;
    width: 68px;
    height: 68px;
    padding: 8px;
    border: 0;
    border-radius: 50%;
    background: rgba(24, 31, 14, 0.4);
    opacity: 0.7;
    transition: opacity 0.3s ease, transform 0.4s var(--ease), background-color 0.3s ease;
  }

  .dot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dot i {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -8px;
    height: 3px;
    border-radius: 2px;
    background: var(--cream);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .dot:hover {
    opacity: 1;
    transform: translateY(-3px);
  }

  .dot[aria-selected='true'] {
    opacity: 1;
    box-shadow: 0 0 0 4px var(--cream);
  }

  .hero__actions .btn--ghost {
    color: #fffdf5;
  }

  .hero__actions .btn--ghost:hover {
    background: var(--cream);
    color: var(--olive-night);
  }

  .solo-movil {
    display: none;
  }

  @media (max-height: 800px) and (min-width: 901px) {
    .hero__title {
      font-size: clamp(2.6rem, min(7.4vw, 12svh), 8.6rem);
    }

    .hero__lead {
      font-size: 1rem;
      line-height: 1.45;
    }

    .hero__copy {
      gap: 14px;
    }

    .now {
      padding: 10px 10px 10px 18px;
    }

    .now__add {
      min-height: 46px;
    }

    .hero__stage {
      width: min(100%, calc(100svh - 230px), 820px);
    }
  }

  @media (max-width: 900px) {
    .solo-desk {
      display: none;
    }

    .solo-movil {
      display: inline;
    }

    .hero {
      padding-top: calc(38px + 68px + 8px);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0;
    }

    .hero__title {
      font-size: clamp(2.5rem, 13.4vw, 5.2rem);
    }

    .hero__copy {
      gap: 16px;
    }

    .hero__lead {
      font-size: 1.05rem;
    }

    .hero__actions {
      width: 100%;
    }

    .hero__actions .btn {
      flex: 1 1 0;
      padding-inline: 1em;
      min-height: 52px;
    }

    .hero__stage {
      width: min(100%, 440px);
      margin-top: 4px;
    }

    .now {
      padding: 10px 10px 10px 18px;
    }

    .now__note {
      display: none;
    }

    .dots {
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .dot {
      width: 52px;
      height: 52px;
      padding: 6px;
    }
  }
</style>
