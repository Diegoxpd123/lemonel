---
import Icon from './Icon.astro'

const slides = [
  { video: '/video/hero-1.mp4', poster: '/video/hero-1.webp' },
  { video: '/video/hero-2.mp4', poster: '/video/hero-2.webp' },
]
---

<section class="hero" id="inicio" data-hero>
  <div class="hero__media" aria-hidden="true">
    {
      slides.map((s, i) => (
        <video
          class="hero__video"
          data-slide={i}
          src={s.video}
          poster={s.poster}
          autoplay={i === 0}
          muted
          loop
          playsinline
          preload={i === 0 ? 'auto' : 'metadata'}
          disablepictureinpicture
          style={i === 0 ? undefined : 'opacity:0'}
        ></video>
      ))
    }
    <div class="hero__shade"></div>
  </div>

  <div class="hero__body wrap">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">Nueva colección</p>
      <h1 class="hero__title">
        Más que joyas,<br />
        <span class="script">historias tuyas.</span>
      </h1>
      <a class="btn btn--white" href="#novedades">
        Ver colección
        <Icon name="arrow-right" weight="light" />
      </a>
    </div>

    <div class="hero__ctrl" aria-label="Cambiar video">
      <button type="button" class="hero__arrow" aria-label="Anterior" data-hero-prev>
        <Icon name="arrow-left" weight="light" />
      </button>
      <span class="hero__count"><b data-hero-n>1</b> / {slides.length}</span>
      <button type="button" class="hero__arrow" aria-label="Siguiente" data-hero-next>
        <Icon name="arrow-right" weight="light" />
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    background: var(--olive-dk);
    color: var(--white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: opacity;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(40, 42, 30, 0.38) 0%, rgba(40, 42, 30, 0) 24%),
      linear-gradient(0deg, rgba(40, 42, 30, 0.62) 0%, rgba(40, 42, 30, 0) 52%);
  }

  .hero__body {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: clamp(32px, 5vw, 64px);
  }

  .hero__copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .hero__eyebrow {
    color: rgba(254, 252, 248, 0.85);
  }

  .hero__title {
    font-size: clamp(2.6rem, 6.4vw, 6rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero__title .script {
    display: inline-block;
    font-size: 1.22em;
    line-height: 0.9;
    margin-top: 0.06em;
  }

  .hero__ctrl {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
    padding: 6px;
    border: 1px solid rgba(254, 252, 248, 0.5);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: rgba(254, 252, 248, 0.1);
  }

  .hero__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(254, 252, 248, 0.92);
    color: var(--olive);
    font-size: 1.2rem;
    transition: background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .hero__arrow:hover {
    background: var(--white);
    transform: scale(1.06);
  }

  .hero__count {
    min-width: 46px;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 100svh;
    }

    .hero__body {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
      padding-bottom: 40px;
    }

    .hero__title {
      font-size: clamp(2.5rem, 12vw, 3.6rem);
    }

    .hero__ctrl {
      align-self: stretch;
      justify-content: space-between;
    }
  }
</style>
