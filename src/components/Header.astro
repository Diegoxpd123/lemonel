---
import Icon from './Icon.astro'
import { navegacion } from '../data/content'
import { config } from '../data/config'
import { colecciones } from '../data/products'

const tipos = [
  { id: 'collares', nombre: 'Collares' },
  { id: 'aretes', nombre: 'Aretes' },
  { id: 'anillos', nombre: 'Anillos' },
  { id: 'pulseras', nombre: 'Pulseras' },
  { id: 'relojes', nombre: 'Relojes' },
]
---

<header class="head" data-header data-state="top">
  <div class="head__bar">
    <div class="head__left">
      <button class="head__burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu" data-burger>
        <span></span>
        <span></span>
      </button>
      <nav class="head__nav" aria-label="Principal">
        {
          navegacion.map((l) =>
            l.mega ? (
              <button class="nav-link nav-link--mega" type="button" aria-expanded="false" aria-controls="mega" data-mega-toggle>
                {l.texto}
                <Icon name="caret-down" weight="bold" />
              </button>
            ) : (
              <a class="nav-link" href={l.href}>
                {l.texto}
              </a>
            ),
          )
        }
      </nav>
    </div>

    <a class="head__logo" href="#inicio" aria-label="Lemonel, inicio">LEMONEL</a>

    <div class="head__right">
      <button class="head__ico" type="button" aria-label="Buscar" data-abrir-busqueda>
        <Icon name="magnifying-glass" weight="light" />
      </button>
      <button class="head__ico" type="button" aria-label="Favoritos" data-ver-favoritos>
        <Icon name="heart" weight="light" />
        <span class="head__dot" data-fav-count hidden>0</span>
      </button>
      <button class="head__ico" type="button" aria-label="Abrir carrito" data-abrir-carrito>
        <Icon name="handbag" weight="light" />
        <span class="head__dot" data-count>0</span>
      </button>
    </div>
  </div>

  <div class="mega" id="mega" data-mega hidden>
    <div class="mega__in wrap">
      <div class="mega__cols">
        <div class="mega__col">
          <p class="mega__t">Por tipo</p>
          <ul>
            <li><a href="#catalogo" data-filtro="todo">Todas las joyas</a></li>
            {tipos.map((t) => <li><a href="#catalogo" data-filtro={t.id}>{t.nombre}</a></li>)}
          </ul>
        </div>
        <div class="mega__col">
          <p class="mega__t">Colecciones</p>
          <ul>
            {colecciones.map((c) => <li><a href="#catalogo" data-coleccion={c.id}>{c.nombre}</a></li>)}
          </ul>
        </div>
        <div class="mega__col">
          <p class="mega__t">Ocasiones</p>
          <ul>
            <li><a href="#regalos">Regalos</a></li>
            <li><a href="#eventos">Misas y eventos</a></li>
            <li><a href="#vendidos">Más vendidos</a></li>
          </ul>
        </div>
      </div>
      <div class="mega__tiles">
        <a class="mega__tile" href="#novedades">
          <img src="/fotos/b-nuevo.webp" alt="" width="640" height="440" loading="lazy" decoding="async" />
          <span>Novedades</span>
        </a>
        <a class="mega__tile" href="#eventos">
          <img src="/fotos/b-eventos.webp" alt="" width="640" height="440" loading="lazy" decoding="async" />
          <span>Eventos</span>
        </a>
      </div>
    </div>
  </div>
</header>

<div class="veil" data-veil hidden></div>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__card" role="dialog" aria-modal="true" aria-label="Menú">
    <div class="menu__panel" data-panel="main">
      <button class="menu__close" type="button" aria-label="Cerrar menú" data-cerrar-menu>
        <Icon name="x" weight="light" />
      </button>
      <nav class="menu__main" aria-label="Menú móvil">
        <a href="#novedades" data-menu-link>Novedades</a>
        <a href="#vendidos" data-menu-link>Más vendidos</a>
        <button type="button" class="menu__sub" data-sub="joyas">
          <span>Joyas</span>
          <Icon name="caret-right" weight="bold" />
        </button>
        <a href="#eventos" data-menu-link>Eventos</a>
        <a href="#preguntas" data-menu-link>Preguntas</a>
      </nav>
    </div>

    <div class="menu__panel menu__panel--sub" data-panel="joyas" hidden>
      <button class="menu__back" type="button" data-back>
        <Icon name="arrow-left" weight="light" />
        <span>Joyas</span>
      </button>
      <ul class="menu__list">
        <li><a href="#catalogo" data-menu-link data-filtro="todo">Todas las joyas</a></li>
        {tipos.map((t) => <li><a href="#catalogo" data-menu-link data-filtro={t.id}>{t.nombre}</a></li>)}
        {colecciones.map((c) => <li><a href="#catalogo" data-menu-link data-coleccion={c.id}>{c.nombre}</a></li>)}
      </ul>
    </div>

    <div class="menu__foot">
      <div class="menu__row">
        <a href={`https://wa.me/${config.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
        <button type="button" data-ver-favoritos data-menu-link>Favoritos</button>
      </div>
      <button class="menu__search" type="button" data-abrir-busqueda>
        <span>Buscar joyas…</span>
        <Icon name="magnifying-glass" weight="light" />
      </button>
      <p class="menu__logo">LEMONEL</p>
    </div>
  </div>
</div>

<div class="busca" data-busca hidden>
  <div class="busca__in wrap">
    <form class="busca__form" role="search" data-busca-form>
      <Icon name="magnifying-glass" weight="light" />
      <input type="search" placeholder="Buscar joyas…" aria-label="Buscar joyas" autocomplete="off" data-busca-input />
      <button type="button" class="busca__x" aria-label="Cerrar búsqueda" data-cerrar-busqueda>
        <Icon name="x" weight="light" />
      </button>
    </form>
    <ul class="busca__res" data-busca-res></ul>
  </div>
</div>

<style>
  .head {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    color: var(--white);
    transition: transform 0.5s var(--ease-out);
  }

  .head[data-oculto='true'] {
    transform: translateY(-110%);
  }

  .head__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
    margin: 0;
    padding-inline: var(--pad);
    border-radius: 0;
    background: transparent;
    border: 1px solid transparent;
    transition:
      height 0.4s var(--ease),
      margin 0.4s var(--ease),
      padding 0.4s var(--ease),
      border-radius 0.4s var(--ease),
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .head[data-state='solid'] .head__bar,
  .head[data-state='open'] .head__bar {
    color: var(--ink);
  }

  .head[data-state='solid'] .head__bar {
    height: 58px;
    margin: 14px 14px 0;
    padding-inline: 22px;
    border-radius: 30px;
    background: rgba(254, 252, 248, 0.94);
    border-color: var(--line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px rgba(52, 56, 42, 0.08);
  }

  .head[data-state='open'] .head__bar {
    background: var(--white);
    border-bottom-color: var(--line);
  }

  .head__left {
    display: flex;
    align-items: center;
    gap: 28px;
    min-width: 0;
  }

  .head__nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.2vw, 34px);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-link:hover::after,
  .nav-link[aria-expanded='true']::after {
    transform: scaleX(1);
  }

  .nav-link :global(.icon) {
    font-size: 0.9rem;
    transition: transform 0.3s var(--ease);
  }

  .nav-link[aria-expanded='true'] :global(.icon) {
    transform: rotate(180deg);
  }

  .head__logo {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    font-weight: 400;
    letter-spacing: 0.34em;
    padding-left: 0.34em;
    line-height: 1;
  }

  .head__right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
  }

  .head__ico {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1.5rem;
    transition: transform 0.25s var(--ease);
  }

  .head__ico:hover {
    transform: translateY(-2px);
  }

  .head__dot {
    position: absolute;
    top: 4px;
    right: 2px;
    display: grid;
    place-items: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--olive);
    color: var(--white);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
  }

  .head__dot[hidden] {
    display: none;
  }

  .head__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .head__burger span {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 1.5px;
    background: currentColor;
  }

  .head__burger span:nth-child(1) {
    top: 17px;
  }

  .head__burger span:nth-child(2) {
    top: 25px;
  }

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--white);
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 30px 40px rgba(52, 56, 42, 0.08);
  }

  .head[data-state='solid'] .mega {
    top: calc(100% + 6px);
    margin-inline: 14px;
    border-radius: 24px;
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .mega[hidden] {
    display: none;
  }

  .mega__in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    padding-block: 36px 44px;
  }

  .mega__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .mega__t {
    margin-bottom: 14px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .mega__col li a {
    display: inline-block;
    padding: 6px 0;
    font-size: 0.875rem;
    color: var(--ink-soft);
    transition: color 0.2s var(--ease), transform 0.3s var(--ease-out);
  }

  .mega__col li a:hover {
    color: var(--olive);
    transform: translateX(4px);
  }

  .mega__tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .mega__tile {
    display: grid;
    gap: 10px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
  }

  .mega__tile img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
    transition: transform 0.7s var(--ease-out);
  }

  .mega__tile {
    overflow: hidden;
  }

  .mega__tile:hover img {
    transform: scale(1.04);
  }

  .veil {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(40, 42, 30, 0.42);
  }

  .veil[hidden] {
    display: none;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    align-items: flex-end;
    padding: 10px;
    background: rgba(40, 42, 30, 0.42);
  }

  .menu:not([hidden]) {
    display: flex;
  }

  .menu__card {
    position: relative;
    width: 100%;
    max-height: calc(100svh - 20px);
    overflow-y: auto;
    padding: 22px 26px 22px;
    border-radius: 28px;
    background: rgba(254, 252, 248, 0.9);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    color: var(--ink);
  }

  .menu__close,
  .menu__back {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    border: 0;
    background: transparent;
    font-size: 1.7rem;
  }

  .menu__back span {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .menu__main {
    display: grid;
    gap: 2px;
    margin-top: 12px;
  }

  .menu__main a,
  .menu__sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 0;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 8vw, 2.2rem);
    line-height: 1.15;
    text-align: left;
  }

  .menu__sub {
    font-size: clamp(1.75rem, 8vw, 2.2rem);
  }

  .menu__sub :global(.icon) {
    font-size: 1.1rem;
  }

  .menu__list {
    margin-top: 10px;
  }

  .menu__list a {
    display: block;
    padding: 10px 0;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--line);
  }

  .menu__panel[hidden] {
    display: none;
  }

  .menu__foot {
    display: grid;
    gap: 14px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .menu__row {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .menu__row button {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .menu__search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .menu__search :global(.icon) {
    font-size: 1.3rem;
  }

  .menu__logo {
    padding-top: 6px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.34em;
    padding-left: 0.34em;
  }

  .busca {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 80;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 30px 50px rgba(52, 56, 42, 0.12);
    max-height: 100svh;
    overflow-y: auto;
  }

  .busca[hidden] {
    display: none;
  }

  .busca__in {
    padding-block: 18px 28px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .busca__form {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 62px;
    padding: 0 8px 0 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    font-size: 1.5rem;
  }

  .busca__form input {
    flex: 1;
    min-width: 0;
    height: 58px;
    border: 0;
    background: transparent;
    font-size: 1rem;
    outline: none;
  }

  .busca__x {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    font-size: 1.5rem;
  }

  .busca__res {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;
    margin-top: 20px;
  }

  @media (max-width: 960px) {
    :root {
      --header-h: 68px;
    }

    .head__nav {
      display: none;
    }

    .head__burger {
      display: block;
    }

    .head__left {
      gap: 0;
    }

    .head[data-state='solid'] .head__bar {
      margin: 10px 10px 0;
      height: 54px;
      padding-inline: 12px;
    }

    .mega {
      display: none !important;
    }
  }
</style>
