---
import Icon from './Icon.astro'
import { colecciones, productos } from '../data/products'

const cuenta = (id: string) => productos.filter((p) => p.colecciones?.includes(id)).length
---

<section class="cols" id="colecciones" data-colecciones>
  {colecciones.map((c, i) => (
    <article class={`col col--${c.tono} ${i % 2 ? 'col--flip' : ''}`} data-col-panel>
      <div class="col__text wrap">
        <h2 data-col-title>{c.nombre}</h2>
        <p data-reveal>{c.frase}</p>
        <button class="btn btn--cream" type="button" data-ver-col={c.id} data-nombre={c.nombre} data-reveal>
          Ver las {cuenta(c.id)} piezas
          <Icon name="arrow-right" weight="bold" />
        </button>
      </div>
      <div class="col__art">
        <div class="col__photo" data-col-piece>
          <img src={c.foto} alt="" width="900" height="1125" loading="lazy" decoding="async" />
        </div>
        <div class="col__photo col__photo--small" data-col-small>
          <img src={c.foto2} alt="" width="900" height="1125" loading="lazy" decoding="async" />
        </div>
      </div>
    </article>
  ))}
</section>

<style>
  .col {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    align-items: center;
    min-height: min(64svh, 600px);
    overflow: hidden;
    color: #fffdf5;
  }

  .col--flip .col__text {
    order: 2;
  }

  .col--lilac {
    background: var(--plum);
  }

  .col--sage {
    background: var(--forest);
  }

  .col--blush {
    background: var(--wine);
  }

  .col--sand {
    background: var(--amber);
  }

  .col__text {
    display: grid;
    justify-items: start;
    gap: 28px;
    padding-block: clamp(28px, 4vw, 56px);
  }

  .col__text h2 {
    font-size: clamp(3.4rem, 10.5vw, 11.4rem);
    line-height: 0.88;
  }

  .col__text p {
    max-width: 29rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 48;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 480;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .col__art {
    position: relative;
    display: grid;
    place-items: center;
    align-self: stretch;
    padding: clamp(16px, 2.4vw, 36px);
  }

  .col__photo {
    width: min(100%, 400px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .col__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .col__photo--small {
    position: absolute;
    left: clamp(12px, 3vw, 48px);
    bottom: clamp(24px, 4vw, 64px);
    width: clamp(120px, 15vw, 220px);
    border: 6px solid currentColor;
    box-sizing: content-box;
    color: inherit;
  }

  .col--flip .col__photo--small {
    left: auto;
    right: clamp(12px, 3vw, 48px);
  }

  @media (max-width: 800px) {
    .col,
    .col--flip {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .col--flip .col__text {
      order: 0;
    }

    .col__text {
      padding-bottom: 12px;
    }

    .col__art {
      padding: 12px var(--gutter) 56px;
    }

    .col__photo {
      width: min(80%, 360px);
    }

    .col__photo--small {
      left: auto;
      right: calc(var(--gutter) + 4px);
      bottom: 28px;
      width: 34%;
    }

    .col--flip .col__photo--small {
      right: calc(var(--gutter) + 4px);
    }
  }
</style>
