---
import { colecciones } from '../data/products'
---

<section class="cols" id="colecciones">
  <div class="cols__head wrap" data-rv>
    <p class="eyebrow">Otras colecciones</p>
    <h2 class="titulo">La misma esencia, otro estilo</h2>
  </div>
  <div class="cols__grid wrap">
    {
      colecciones.map((c) => (
        <a class="tile" href="#catalogo" data-coleccion={c.id}>
          <img src={c.foto} alt="" width="900" height="1125" loading="lazy" decoding="async" />
          <span class="tile__shade"></span>
          <span class="tile__name">{c.nombre}</span>
        </a>
      ))
    }
    <a class="tile" href="#catalogo" data-filtro="todo">
      <img src="/fotos/g-02.webp" alt="" width="800" height="1200" loading="lazy" decoding="async" />
      <span class="tile__shade"></span>
      <span class="tile__name">Todas las joyas</span>
    </a>
  </div>
</section>

<style>
  .cols {
    padding-block: var(--gap-section);
    background: var(--white);
  }

  .cols__head {
    display: grid;
    gap: 8px;
    margin-bottom: clamp(18px, 2vw, 28px);
  }

  .cols__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 14px);
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--card);
    color: var(--white);
  }

  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .tile:hover img {
    transform: scale(1.06);
  }

  .tile__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(40, 42, 30, 0.6) 0%, rgba(40, 42, 30, 0) 55%);
  }

  .tile__name {
    position: absolute;
    left: 20px;
    right: 16px;
    bottom: 18px;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.8vw, 1.8rem);
    line-height: 1.1;
  }

  @media (max-width: 960px) {
    .cols__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile:last-child {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 9;
    }
  }
</style>
