---
import Icon from './Icon.astro'

interface Props {
  id?: string
  foto: string
  etiqueta: string
  titulo: string
  texto?: string
  boton: string
  href?: string
  filtro?: string
  posicion?: string
  derecha?: boolean
}

const { id, foto, etiqueta, titulo, texto, boton, href = '#catalogo', filtro, posicion = '50% 40%', derecha = false } = Astro.props
---

<section class={`banner ${derecha ? 'banner--der' : ''}`} id={id} data-banner>
  <img class="banner__img" src={foto} alt="" width="2200" height="1100" loading="lazy" decoding="async" style={`object-position:${posicion}`} data-parallax />
  <div class="banner__shade"></div>
  <div class="banner__body wrap">
    <div class="banner__copy" data-rv>
      <p class="eyebrow">{etiqueta}</p>
      <h2 class="banner__title">{titulo}</h2>
      {texto && <p class="banner__text">{texto}</p>}
      <a class="btn btn--ghost-white" href={href} data-filtro={filtro}>
        {boton}
        <Icon name="arrow-right" weight="light" />
      </a>
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(420px, 62vh, 640px);
    overflow: hidden;
    background: var(--olive-dk);
    color: var(--white);
  }

  .banner__img {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    will-change: transform;
  }

  .banner__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(40, 42, 30, 0.58) 0%, rgba(40, 42, 30, 0) 60%);
  }

  .banner--der .banner__shade {
    background: linear-gradient(0deg, rgba(40, 42, 30, 0.58) 0%, rgba(40, 42, 30, 0) 60%);
  }

  .banner__body {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(28px, 4vw, 56px);
  }

  .banner--der .banner__copy {
    margin-left: auto;
    text-align: right;
    justify-items: end;
  }

  .banner__copy {
    display: grid;
    gap: 16px;
    justify-items: start;
    max-width: 34rem;
  }

  .banner .eyebrow {
    color: rgba(254, 252, 248, 0.88);
  }

  .banner__title {
    font-size: clamp(2.4rem, 5.6vw, 5rem);
    line-height: 1.02;
  }

  .banner__text {
    max-width: 26rem;
    font-size: 0.95rem;
    color: rgba(254, 252, 248, 0.92);
  }

  @media (max-width: 760px) {
    .banner {
      min-height: 520px;
    }

    .banner--der .banner__copy {
      margin-left: 0;
      text-align: left;
      justify-items: start;
    }
  }
</style>
