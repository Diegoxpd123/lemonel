---
import Icon from './Icon.astro'
import Tarjeta from './Tarjeta.astro'
import { getTienda } from '../data/api'

const tienda = await getTienda()
const lista = tienda.productos.filter((p) => p.destacado)
---

<section class="vend" id="vendidos">
  <div class="vend__head wrap">
    <div data-rv>
      <p class="eyebrow">Descubre los más vendidos</p>
      <h2 class="titulo">Joyas para todos tus días</h2>
    </div>
    <button class="vend__next" type="button" aria-label="Ver más" data-carrusel-next>
      <Icon name="caret-right" weight="bold" />
    </button>
  </div>

  <div class="vend__track" data-carrusel tabindex="-1">
    <div class="vend__row">
      {lista.map((p) => <Tarjeta p={p} carrusel />)}
    </div>
  </div>

  <div class="vend__ctrl wrap" aria-hidden="true">
    <div class="vend__bar"><i data-carrusel-barra></i></div>
  </div>
</section>

<style>
  .vend {
    padding-block: var(--gap-section) clamp(36px, 4vw, 56px);
    background: var(--ivory);
  }

  .vend__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(20px, 2.4vw, 32px);
  }

  .vend__head .eyebrow {
    margin-bottom: 8px;
  }

  .vend__next {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    font-size: 1.1rem;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .vend__next:hover {
    background: var(--olive);
    color: var(--white);
    transform: translateX(3px);
  }

  .vend__track {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-inline: var(--pad);
    scroll-padding-inline: var(--pad);
  }

  .vend__track::-webkit-scrollbar {
    display: none;
  }

  .vend__row {
    display: flex;
    gap: clamp(8px, 1vw, 14px);
    width: max-content;
  }

  .vend__row :global(.card--slide) {
    flex: none;
    width: clamp(240px, 23.4vw, 340px);
    scroll-snap-align: start;
  }

  .vend__ctrl {
    margin-top: 26px;
  }

  .vend__bar {
    height: 2px;
    background: var(--cloud);
    overflow: hidden;
  }

  .vend__bar i {
    display: block;
    height: 100%;
    width: 30%;
    background: var(--olive);
    transform-origin: 0 50%;
    will-change: transform;
  }

  @media (max-width: 760px) {
    .vend__row :global(.card--slide) {
      width: 66vw;
    }

    .vend__next {
      display: none;
    }
  }
</style>
