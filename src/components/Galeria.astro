---
import Icon from './Icon.astro'
import { galeria } from '../data/gallery'
---

<section class="gal" id="galeria">
  <div class="gal__head wrap">
    <h2 data-reveal>Así se lucen</h2>
    <div class="gal__side" data-reveal>
      <p>Cadenas finas, perlas y argollas para cada día. Mira cómo se llevan y arma tu favorita.</p>
      <a class="btn" href="#catalogo">
        Ver el catálogo
        <Icon name="arrow-right" weight="bold" />
      </a>
    </div>
  </div>

  <div class="gal__grid wrap">
    {
      galeria.map((f) => (
        <figure class={`gal__item ${f.h / f.w > 1.3 ? 'gal__item--alto' : ''}`} data-gal>
          <img src={f.src} alt={f.alt} width={f.w} height={f.h} loading="lazy" decoding="async" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .gal {
    padding-block: var(--section);
    background: var(--arena);
    color: var(--ink);
  }

  .gal__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    align-items: end;
    gap: 28px 64px;
    margin-bottom: clamp(18px, 2.4vw, 32px);
  }

  .gal__head h2 {
    font-size: clamp(2.8rem, 8vw, 8.6rem);
  }

  .gal__side {
    display: grid;
    gap: 22px;
    justify-items: start;
    padding-bottom: 0.5em;
    font-size: 1.2rem;
  }

  .gal__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(150px, 16.5vw, 250px);
    grid-auto-flow: dense;
    gap: 6px;
  }

  .gal__item {
    margin: 0;
    overflow: hidden;
  }

  .gal__item--alto {
    grid-row: span 2;
  }

  .gal__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .gal__item:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 1100px) {
    .gal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: clamp(140px, 22vw, 240px);
    }
  }

  @media (max-width: 760px) {
    .gal__head {
      grid-template-columns: 1fr;
    }

    .gal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(140px, 40vw, 220px);
    }
  }
</style>
