---
import { preguntas } from '../data/content'
---

<section class="faq" id="preguntas" data-faq>
  <div class="faq__head" data-rv>
    <p class="eyebrow">Ayuda</p>
    <h2 class="titulo">Preguntas <span class="script">frecuentes</span></h2>
    <p class="faq__txt">¿No encuentras tu respuesta? Escríbenos por WhatsApp y te ayudamos.</p>
  </div>

  <div class="faq__list" data-rv>
    {
      preguntas.map((p, i) => (
        <div class="faq__item" data-item>
          <h3>
            <button class="faq__q" type="button" aria-expanded="false" aria-controls={`faq-${i}`} data-q>
              <span>{p.q}</span>
              <i aria-hidden="true"></i>
            </button>
          </h3>
          <div class="faq__a" id={`faq-${i}`} role="region" hidden>
            <p>{p.a}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(24px, 6vw, 96px);
    padding: var(--gap-section) var(--pad);
    background: var(--white);
  }

  .faq__head {
    display: grid;
    gap: 14px;
    align-content: start;
    position: sticky;
    top: 110px;
    align-self: start;
  }

  .faq__head .script {
    font-size: 1.3em;
    line-height: 0.9;
  }

  .faq__txt {
    max-width: 22rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__item:first-child {
    border-top: 1px solid var(--line);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    min-height: 72px;
    padding: 18px 0;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.25;
    text-align: left;
  }

  .faq__q i {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .faq__q i::before,
  .faq__q i::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 8.25px;
    height: 1.5px;
    background: var(--olive);
    transition: transform 0.4s var(--ease-out);
  }

  .faq__q i::after {
    transform: rotate(90deg);
  }

  .faq__q[aria-expanded='true'] i::after {
    transform: rotate(0deg);
  }

  .faq__q:hover span {
    color: var(--olive);
  }

  .faq__a {
    overflow: hidden;
  }

  .faq__a[hidden] {
    display: none;
  }

  .faq__a p {
    max-width: 38rem;
    padding: 0 0 22px;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
    }

    .faq__head {
      position: static;
    }
  }
</style>
