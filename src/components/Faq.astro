---
import { config } from '../data/config'

const preguntas = [
  {
    q: '¿Hacen envíos a todo el Perú?',
    a: 'Sí. Cuando armas tu caja, coordinamos el envío contigo por WhatsApp y te avisamos apenas salga.',
  },
  {
    q: '¿Cómo pago mi pedido?',
    a: 'Te confirmamos la disponibilidad y el total por WhatsApp. Ahí mismo te indicamos los medios de pago.',
  },
  {
    q: '¿Puedo pedir para un evento?',
    a: `Claro. Desde ${config.eventoMinimo} piezas iguales tienes descuento por cantidad. Pide con ${config.diasAnticipacion} días de anticipación y cuéntanos la fecha.`,
  },
  {
    q: '¿Personalizan las tarjetas o el empaque?',
    a: 'Sí. Podemos poner un nombre o una fecha en la tarjeta y elegir el color del lazo. Escríbelo en la nota de tu caja.',
  },
  {
    q: '¿Puedo cambiar algo de mi pedido?',
    a: 'Por supuesto. No se cobra nada hasta que lo confirmemos contigo, así que puedes cambiar piezas o cantidades antes.',
  },
]
---

<section class="faq" id="preguntas" data-faq>
  <div class="faq__head wrap">
    <div class="faq__sticky">
      <h2 data-reveal>Preguntas frecuentes</h2>
      <img src="/fotos/entrega-modelo.webp" alt="Collares dorados en capas sobre una blusa blanca" width="900" height="1125" loading="lazy" decoding="async" data-reveal />
    </div>
  </div>
  <div class="faq__list wrap">
    {preguntas.map((p) => (
      <details class="faq__item" data-reveal>
        <summary>
          <span>{p.q}</span>
          <span class="faq__plus" aria-hidden="true"></span>
        </summary>
        <p>{p.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px 40px;
    align-items: start;
  }

  .faq__sticky {
    display: grid;
    gap: 28px;
    position: sticky;
    top: 110px;
  }

  .faq__head h2 {
    font-size: clamp(2.6rem, 6vw, 6.4rem);
  }

  .faq__sticky img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .faq__list {
    display: grid;
    gap: 10px;
  }

  .faq__item {
    background: var(--cream-2);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
    padding: 14px 24px;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 72;
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__plus {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--olive-deep);
    transition: transform 0.4s var(--ease);
  }

  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    top: 19px;
    height: 2px;
    background: var(--cream);
  }

  .faq__plus::after {
    transform: rotate(90deg);
    transition: transform 0.4s var(--ease);
  }

  details[open] .faq__plus {
    transform: rotate(180deg);
  }

  details[open] .faq__plus::after {
    transform: rotate(0deg);
  }

  .faq__item p {
    max-width: 38rem;
    padding: 0 24px 26px;
    font-size: 1.1rem;
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
    }

    .faq__sticky {
      position: static;
    }

    .faq__sticky img {
      display: none;
    }
  }
</style>
