---
const frase = 'Amor en cada detalle'
const items = Array.from({ length: 8 })
---

<div class="cinta" aria-hidden="true">
  <div class="cinta__track" data-cinta-track>
    {items.map(() => <span>{frase}</span>)}
  </div>
</div>

<style>
  .cinta {
    background: var(--blush);
    color: var(--olive-deep);
    overflow: hidden;
    padding-block: clamp(8px, 1.2vw, 16px);
  }

  .cinta__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
  }

  .cinta__track span {
    padding-right: clamp(32px, 5vw, 80px);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    font-style: italic;
    font-size: clamp(2rem, 5.2vw, 4.6rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
</style>
