---
import Icon from './Icon.astro'
---

<div class="pveil" data-pveil hidden></div>

<div class="prod" data-prod role="dialog" aria-modal="true" aria-labelledby="prod-t" hidden>
  <button class="prod__close" type="button" aria-label="Cerrar" data-cerrar-producto>
    <Icon name="x" weight="light" />
  </button>
  <div class="prod__gal">
    <div class="prod__stage">
      <img data-prod-img src="" alt="" width="900" height="1125" />
    </div>
    <ul class="prod__thumbs" data-prod-thumbs aria-label="Fotos del producto"></ul>
  </div>
  <div class="prod__info">
    <p class="eyebrow" data-prod-cat></p>
    <h2 id="prod-t" data-prod-name></h2>
    <p class="prod__price" data-prod-price></p>
    <p class="prod__mat" data-prod-mat></p>
    <p class="prod__txt" data-prod-det></p>

    <div class="prod__opts" data-prod-opts></div>

    <div class="prod__diseno" data-prod-diseno hidden>
      <label for="prod-diseno">¿Cuál de la foto te gusta?</label>
      <textarea id="prod-diseno" rows="2" maxlength="160" placeholder="Cuéntanos el modelo o describe el que quieres" data-prod-diseno-txt></textarea>
    </div>

    <div class="prod__qty" data-prod-qty>
      <span>Cantidad</span>
      <div class="prod__step">
        <button type="button" aria-label="Una menos" data-prod-menos><Icon name="minus" weight="light" /></button>
        <input type="number" inputmode="numeric" min="1" value="1" aria-label="Cantidad" data-prod-cant />
        <button type="button" aria-label="Una más" data-prod-mas><Icon name="plus" weight="light" /></button>
      </div>
    </div>

    <p class="prod__error" data-prod-error role="alert" hidden></p>

    <button class="btn prod__add" type="button" data-prod-add>
      <span data-prod-add-t>Agregar al carrito</span>
      <Icon name="arrow-right" weight="light" />
    </button>
    <a class="btn btn--line prod__consulta" data-prod-consulta target="_blank" rel="noopener" hidden>
      <Icon name="whatsapp-logo" weight="light" />
      <span>Consultar por WhatsApp</span>
    </a>
    <button class="prod__fav" type="button" data-prod-fav>
      <Icon name="heart" weight="light" />
      <span data-prod-fav-t>Agregar a favoritos</span>
    </button>

    <ul class="prod__ben">
      <li><Icon name="truck" weight="light" /> Envíos a todo el Perú</li>
      <li><Icon name="gift" weight="light" /> Cada pieza va en su cajita</li>
      <li><Icon name="hand-heart" weight="light" /> Separa tu pedido y completa el pago después</li>
    </ul>
  </div>
</div>

<style is:global>
  .pveil {
    position: fixed;
    inset: 0;
    z-index: 110;
    background: rgba(40, 42, 30, 0.5);
  }

  .pveil[hidden],
  .prod[hidden] {
    display: none;
  }

  .prod {
    position: fixed;
    z-index: 120;
    top: 50%;
    left: 50%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    width: min(1040px, calc(100% - 32px));
    max-height: calc(100svh - 32px);
    transform: translate(-50%, -50%);
    border-radius: 24px;
    background: var(--ivory);
    overflow: hidden;
  }

  .prod__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: rgba(254, 252, 248, 0.92);
    font-size: 1.5rem;
    transition: background-color 0.25s var(--ease);
  }

  .prod__close:hover {
    background: var(--white);
  }

  .prod__gal {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 420px;
    background: var(--card);
  }

  .prod__stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  .prod__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s var(--ease);
  }

  .prod__thumbs {
    display: flex;
    gap: 8px;
    padding: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--ivory);
  }

  .prod__thumbs::-webkit-scrollbar {
    display: none;
  }

  .prod__thumbs:empty {
    display: none;
  }

  .prod__thumb {
    flex: none;
    width: 60px;
    height: 74px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    background: var(--cloud);
    overflow: hidden;
    transition: border-color 0.2s var(--ease);
  }

  .prod__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prod__thumb[aria-current='true'] {
    border-color: var(--olive);
  }

  .prod__info {
    display: grid;
    gap: 14px;
    align-content: center;
    padding: clamp(24px, 4vw, 52px);
    overflow-y: auto;
  }

  .prod__info h2 {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
  }

  .prod__price {
    font-size: 1.15rem;
  }

  .prod__txt {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .prod__mat {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--olive);
  }

  .prod__opts {
    display: grid;
    gap: 16px;
  }

  .opt {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .opt legend {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
    padding: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .opt legend b {
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.08em;
  }

  .opt__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .opt__chips--letras {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(38px, 1fr));
    gap: 6px;
  }

  .opt__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-size: 0.8125rem;
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .opt__chips--letras .opt__chip {
    padding: 0;
    border-radius: 10px;
  }

  .opt__chip:hover:not(:disabled) {
    border-color: var(--olive);
  }

  .opt__chip[aria-pressed='true'] {
    border-color: var(--olive);
    background: var(--olive);
    color: var(--white);
  }

  .opt__chip:disabled {
    opacity: 0.45;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .opt__chip small {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .opt__dot {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(52, 56, 42, 0.3);
    border-radius: 50%;
  }

  .opt--error legend {
    color: #a63d40;
  }

  .opt--error .opt__chip {
    border-color: #a63d40;
  }

  .prod__diseno {
    display: grid;
    gap: 8px;
  }

  .prod__diseno label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .prod__diseno textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--white);
    resize: vertical;
  }

  .prod__error {
    padding: 10px 14px;
    border-radius: 12px;
    background: #f3dcdc;
    color: #8c2f32;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .prod__error[hidden],
  .prod__consulta[hidden],
  .prod__diseno[hidden],
  .prod__qty[hidden] {
    display: none;
  }

  .prod__consulta {
    width: 100%;
  }

  .prod__qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 4px;
  }

  .prod__qty > span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .prod__step {
    display: inline-grid;
    grid-template-columns: 42px 50px 42px;
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow: hidden;
  }

  .prod__step button {
    display: grid;
    place-items: center;
    min-height: 46px;
    border: 0;
    background: transparent;
    font-size: 1.05rem;
  }

  .prod__step button:hover {
    background: var(--cloud);
  }

  .prod__step input {
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    text-align: center;
    font-weight: 500;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .prod__step input::-webkit-outer-spin-button,
  .prod__step input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .prod__add {
    width: 100%;
  }

  .prod__fav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    border: 0;
    background: transparent;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .prod__fav .icon {
    font-size: 1.3rem;
  }

  .prod__ben {
    display: grid;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .prod__ben li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .prod__ben .icon {
    font-size: 1.4rem;
    color: var(--olive);
  }

  @media (max-width: 760px) {
    .prod {
      top: auto;
      bottom: 0;
      left: 0;
      width: 100%;
      max-height: 94svh;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      transform: none;
      border-radius: 24px 24px 0 0;
      overflow-y: auto;
    }

    .prod__gal {
      display: block;
      min-height: 0;
    }

    .prod__stage {
      aspect-ratio: 1;
    }

    .prod__info {
      overflow: visible;
    }
  }
</style>
