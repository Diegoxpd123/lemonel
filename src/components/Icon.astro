---
interface Props {
  name: string
  weight?: 'light' | 'regular' | 'bold' | 'fill'
  class?: string
}

const { name, weight = 'regular', class: klass = '' } = Astro.props

const conSufijo = import.meta.glob(
  '/node_modules/@phosphor-icons/core/assets/{light,bold,fill}/{gift,package,whatsapp-logo,instagram-logo,tiktok-logo,truck,plus,minus,x,arrow-right,arrow-up-right,calendar-blank,hand-heart,heart,flower,sun,diamond,watch,cross,pencil-simple,check,caret-down,shopping-bag-open,list,handbag,crown-simple,seal-check,chat-circle-dots}-{light,bold,fill}.svg',
  { query: '?raw', import: 'default', eager: true },
) as Record<string, string>

const regulares = import.meta.glob(
  '/node_modules/@phosphor-icons/core/assets/regular/{gift,package,whatsapp-logo,instagram-logo,tiktok-logo,truck,plus,minus,x,arrow-right,arrow-up-right,calendar-blank,hand-heart,heart,flower,sun,diamond,watch,cross,pencil-simple,check,caret-down,shopping-bag-open,list,handbag,crown-simple,seal-check,chat-circle-dots}.svg',
  { query: '?raw', import: 'default', eager: true },
) as Record<string, string>

const base = '/node_modules/@phosphor-icons/core/assets'
const raw = weight === 'regular' ? (regulares[`${base}/regular/${name}.svg`] ?? '') : (conSufijo[`${base}/${weight}/${name}-${weight}.svg`] ?? '')
const svg = raw.replace('<svg ', '<svg width="1em" height="1em" aria-hidden="true" focusable="false" ')
---

<span class={`icon ${klass}`} set:html={svg} />

<style is:global>
  .icon {
    display: inline-flex;
    flex: none;
    width: 1em;
    height: 1em;
    line-height: 0;
  }

  .icon svg {
    width: 100%;
    height: 100%;
  }
</style>
