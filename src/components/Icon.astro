---
interface Props {
  name: string
  weight?: 'light' | 'regular' | 'bold' | 'fill'
  class?: string
}

const { name, weight = 'light', class: klass = '' } = Astro.props

const conSufijo = import.meta.glob(
  '/node_modules/@phosphor-icons/core/assets/{light,bold,fill}/{gift,package,whatsapp-logo,instagram-logo,tiktok-logo,pinterest-logo,truck,plus,minus,x,arrow-right,arrow-left,arrow-up-right,caret-right,caret-left,caret-down,calendar-blank,heart,magnifying-glass,user,handbag,list,trash,credit-card,seal-check,sparkle,check,hand-heart,shopping-bag,receipt,share-network}-{light,bold,fill}.svg',
  { query: '?raw', import: 'default', eager: true },
) as Record<string, string>

const base = '/node_modules/@phosphor-icons/core/assets'
const raw = conSufijo[`${base}/${weight}/${name}-${weight}.svg`] ?? ''
const svg = raw.replace('<svg ', '<svg width="1em" height="1em" aria-hidden="true" focusable="false" ')
---

<span class={`icon ${klass}`} set:html={svg} />

<style is:global>
  .icon {
    display: inline-flex;
    flex: none;
    width: 1em;
    min-width: 1em;
    height: 1em;
    line-height: 0;
  }

  .icon svg {
    width: 100%;
    height: 100%;
  }
</style>
