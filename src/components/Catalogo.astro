---
import Icon from './Icon.astro'
import Tarjeta from './Tarjeta.astro'
import { getTienda } from '../data/api'

const tienda = await getTienda()
const productos = tienda.productos
const categorias = [{ slug: 'todo', nombre: 'Todo' }, ...tienda.categorias]
---

<section class="cat" id="catalogo" data-catalogo>
  <div class="cat__head wrap" data-rv>
    <div>
      <p class="eyebrow">Todos los diseños</p>
      <h2 class="titulo">Elige lo que vas a regalar</h2>
    </div>
    <p class="cat__sub">Agrega tus favoritas al carrito. Cuando termines, tu pedido sale directo a nuestro WhatsApp.</p>
  </div>

  <div class="cat__bar wrap">
    <div class="cat__chips" role="group" aria-label="Filtrar por categoría">
      {categorias.map((c, i) => <button type="button" class="chip" data-chip={c.slug} aria-pressed={i === 0 ? 'true' : 'false'}>{c.nombre}</button>)}
      <button type="button" class="chip" data-chip="favoritos" aria-pressed="false">
        <Icon name="heart" weight="light" />
        Favoritos
      </button>
    </div>
    <button class="cat__clear" type="button" data-limpiar hidden>
      <span data-limpiar-texto></span>
      <Icon name="x" weight="light" />
    </button>
  </div>

  <div class="cat__grid wrap" data-grid>
    {productos.map((p) => <Tarjeta p={p} />)}
  </div>
  <div class="cat__mas wrap">
    <p class="cat__contador" data-contador aria-live="polite"></p>
    <button class="btn btn--line" type="button" data-mas hidden>Ver más joyas</button>
  </div>
  <p class="cat__vacio wrap" data-vacio hidden>Aún no tienes favoritos. Toca el corazón en las joyas que te gusten.</p>
</section>

<style>
  .cat {
    padding-block: var(--gap-section);
    background: var(--ivory);
    scroll-margin-top: 80px;
  }

  .cat__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    flex-wrap: wrap;
    margin-bottom: clamp(18px, 2vw, 28px);
  }

  .cat__head .eyebrow {
    margin-bottom: 8px;
  }

  .cat__sub {
    max-width: 24rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .cat__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: clamp(18px, 2vw, 26px);
  }

  .cat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .chip :global(.icon) {
    font-size: 1.1rem;
  }

  .chip:hover {
    border-color: var(--olive);
  }

  .chip[aria-pressed='true'] {
    background: var(--olive);
    border-color: var(--olive);
    color: var(--white);
  }

  .cat__clear {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: var(--rose);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cat__clear[hidden] {
    display: none;
  }

  .cat__grid {
    --cols: 4;
    --gap: clamp(8px, 1vw, 14px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    row-gap: clamp(24px, 3vw, 40px);
  }

  .cat__grid :global(.card) {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
  }

  .cat__mas {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin-top: clamp(28px, 3vw, 44px);
  }

  .cat__mas [hidden] {
    display: none;
  }

  .cat__contador {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .cat__vacio {
    padding-block: 32px;
    text-align: center;
    color: var(--ink-soft);
  }

  .cat__vacio[hidden] {
    display: none;
  }

  @media (max-width: 960px) {
    .cat__grid {
      --cols: 2;
    }

    .cat__chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--pad) * -1);
      padding-inline: var(--pad);
      scrollbar-width: none;
    }

    .cat__chips::-webkit-scrollbar {
      display: none;
    }

    .chip {
      flex: none;
    }
  }
</style>
