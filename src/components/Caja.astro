---
import Icon from './Icon.astro'
---

<button class="fab" type="button" data-abrir-caja data-fab aria-label="Abrir mi caja">
  <Icon name="gift" weight="regular" />
  <span class="fab__count" data-count>0</span>
</button>

<div class="veil" data-veil hidden></div>

<aside class="caja" data-caja role="dialog" aria-modal="true" aria-labelledby="caja-titulo" hidden>
  <header class="caja__head">
    <div class="caja__title">
      <Icon name="gift" weight="regular" />
      <h2 id="caja-titulo">Tu caja</h2>
    </div>
    <button class="caja__close" type="button" data-cerrar-caja aria-label="Cerrar mi caja">
      <Icon name="x" weight="bold" />
    </button>
  </header>

  <div class="caja__scroll" data-caja-scroll>
    <div class="caja__empty" data-caja-empty>
      <Icon name="gift" weight="light" />
      <p>Tu caja está vacía.</p>
      <span>Elige una joya del catálogo y la acomodamos aquí.</span>
      <a class="btn" href="#catalogo" data-cerrar-caja>
        Ver catálogo
        <Icon name="arrow-right" weight="bold" />
      </a>
    </div>

    <ul class="caja__lines" data-caja-lines></ul>

    <div class="caja__extra" data-caja-extra hidden>
      <label class="check">
        <input type="checkbox" data-evento-toggle />
        <span>Es para un evento</span>
      </label>

      <div class="caja__evento" data-evento-fields hidden>
        <div class="field">
          <label for="caja-tipo">Tipo de evento</label>
          <select id="caja-tipo" data-evento-tipo>
            <option>Misa</option>
            <option>Bautizo</option>
            <option>Primera comunión</option>
            <option>Matrimonio</option>
            <option>Cumpleaños</option>
            <option>Otro</option>
          </select>
        </div>
        <div class="field">
          <label for="caja-fecha">Fecha del evento</label>
          <input id="caja-fecha" type="date" data-evento-fecha />
        </div>
      </div>

      <div class="field">
        <label for="caja-nota">Nota para la tarjeta o el pedido</label>
        <textarea id="caja-nota" rows="2" placeholder="Para quién es, un mensaje, color del lazo…" data-caja-nota></textarea>
      </div>
    </div>

    <div class="caja__lazo" data-lazo aria-hidden="true">
      <i></i>
      <i></i>
      <span><Icon name="gift" weight="regular" /></span>
    </div>
  </div>

  <footer class="caja__foot">
    <div class="caja__total">
      <span>Total</span>
      <strong data-caja-total>S/ 0</strong>
    </div>
    <p class="caja__ahorro" data-caja-ahorro hidden></p>
    <button class="btn btn--gold caja__send" type="button" data-enviar disabled>
      <Icon name="whatsapp-logo" weight="regular" />
      Cerrar la caja y pedir por WhatsApp
    </button>
  </footer>
</aside>

<style>
  .fab {
    position: fixed;
    right: clamp(14px, 2vw, 28px);
    bottom: clamp(14px, 2vw, 28px);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 62px;
    padding: 0 10px 0 18px;
    border: 0;
    border-radius: 999px;
    background: var(--olive-deep);
    color: var(--cream);
    font-size: 1.7rem;
    transition: transform 0.4s var(--ease);
  }

  @media (min-width: 901px) {
    .fab {
      display: none;
    }
  }

  .fab:hover {
    transform: translateY(-3px);
  }

  .fab__count {
    display: grid;
    place-items: center;
    min-width: 42px;
    height: 42px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .veil {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(35, 42, 23, 0.6);
  }

  .veil[hidden],
  .caja[hidden] {
    display: none;
  }

  .caja {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    width: min(520px, 100%);
    background: var(--cream);
    color: var(--ink);
  }

  .caja__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 12px 12px 24px;
    background: var(--olive-deep);
    color: var(--cream);
  }

  .caja__title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 2rem;
  }

  .caja__title h2 {
    font-size: 2rem;
  }

  .caja__close {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 0;
    border-radius: 50%;
    background: var(--cream);
    color: var(--olive-night);
    font-size: 1.5rem;
  }

  .caja__scroll {
    position: relative;
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 20px 24px 24px;
  }

  .caja__empty {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 56px 12px;
    text-align: center;
    font-size: 4.4rem;
    color: var(--olive);
  }

  .caja__empty p {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 72;
    font-size: 1.9rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .caja__empty span {
    font-size: 1.08rem;
    color: var(--ink);
  }

  .caja__empty .btn {
    margin-top: 14px;
    font-size: 1.05rem;
    color: var(--cream);
  }

  .caja__empty[hidden] {
    display: none;
  }

  .caja__lines {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.line) {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) auto;
    gap: 4px 14px;
    align-items: center;
    padding: 10px;
    background: var(--cream-2);
  }

  :global(.line__img) {
    grid-row: 1 / span 2;
    width: 84px;
    height: 104px;
    object-fit: cover;
  }

  :global(.line__name) {
    align-self: end;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 72;
    font-size: 1.3rem;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  :global(.line__price) {
    grid-column: 2;
    align-self: start;
    font-size: 1rem;
    font-weight: 600;
  }

  :global(.line__price s) {
    margin-right: 6px;
    opacity: 0.7;
  }

  :global(.line__tag) {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--gold);
    font-size: 0.85rem;
    font-weight: 700;
  }

  :global(.line__qty) {
    grid-column: 3;
    grid-row: 1;
    display: grid;
    grid-template-columns: 40px 46px 40px;
    align-items: stretch;
  }

  :global(.line__qty button) {
    display: grid;
    place-items: center;
    min-height: 44px;
    border: 0;
    background: var(--olive-deep);
    color: var(--cream);
    font-size: 1.1rem;
  }

  :global(.line__qty button:hover) {
    background: var(--olive-night);
  }

  :global(.line__qty input) {
    width: 100%;
    min-width: 0;
    border: 0;
    border-block: 2px solid var(--olive-deep);
    background: #fffdf5;
    text-align: center;
    font-weight: 700;
    font-size: 1.05rem;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  :global(.line__qty input::-webkit-outer-spin-button),
  :global(.line__qty input::-webkit-inner-spin-button) {
    -webkit-appearance: none;
    margin: 0;
  }

  :global(.line__rm) {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
    padding: 4px 0;
    border: 0;
    background: transparent;
    font-weight: 650;
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .caja__extra {
    display: grid;
    gap: 16px;
    margin-top: 22px;
  }

  .caja__extra[hidden],
  .caja__evento[hidden],
  .caja__ahorro[hidden] {
    display: none;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    font-weight: 650;
    cursor: pointer;
  }

  .check input {
    width: 26px;
    height: 26px;
    accent-color: var(--olive-deep);
  }

  .caja__evento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .field {
    display: grid;
    gap: 6px;
  }

  .field label {
    font-weight: 650;
    font-size: 1rem;
  }

  .caja__lazo {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    visibility: hidden;
  }

  .caja__lazo i {
    position: absolute;
    background: var(--gold);
  }

  .caja__lazo i:nth-child(1) {
    left: 0;
    right: 0;
    top: 50%;
    height: 64px;
    margin-top: -32px;
    transform-origin: 0 50%;
  }

  .caja__lazo i:nth-child(2) {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 64px;
    margin-left: -32px;
    transform-origin: 50% 0;
  }

  .caja__lazo span {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 110px;
    height: 110px;
    margin: -55px 0 0 -55px;
    border-radius: 50%;
    background: var(--olive-deep);
    color: var(--cream);
    font-size: 3rem;
  }

  .caja__foot {
    display: grid;
    gap: 12px;
    padding: 18px 24px 24px;
    background: var(--cream-2);
  }

  .caja__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-weight: 650;
    font-size: 1.1rem;
  }

  .caja__total strong {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    font-size: 2.6rem;
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .caja__ahorro {
    font-weight: 650;
  }

  .caja__send {
    width: 100%;
    min-height: 60px;
    line-height: 1.15;
  }

  .caja__send :global(.icon) {
    font-size: 1.5rem;
  }

  .caja__send:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
  }

  @media (max-width: 520px) {
    .caja__evento {
      grid-template-columns: 1fr;
    }

    :global(.line) {
      grid-template-columns: 72px minmax(0, 1fr);
    }

    :global(.line__img) {
      width: 72px;
      height: 92px;
      grid-row: 1 / span 3;
    }

    :global(.line__qty) {
      grid-column: 2;
      grid-row: 3;
      justify-self: start;
    }

    :global(.line__rm) {
      grid-column: 2;
      grid-row: 4;
      justify-self: start;
    }
  }
</style>
